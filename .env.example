# Environment Configuration - DevCenterPoint SEO Command Center

# Application
APP_NAME="DevCenterPoint SEO Command Center"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database (Default: SQLite for local; configure MySQL for production)
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=devcenterpoint_seo
# DB_USERNAME=root
# DB_PASSWORD=

# Queues
QUEUE_CONNECTION=database

# Crawler Settings
CRAWLER_DEFAULT_MAX_PAGES=100
CRAWLER_DEFAULT_CONCURRENCY=3
CRAWLER_DEFAULT_DELAY_MS=300
CRAWLER_USER_AGENT="DevCenterPoint-SEO-Bot/1.0 (+https://devcenterpoint.com/bot)"

# Google Search Console API (OAuth 2.0 Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback

# Google PageSpeed Insights API
PAGESPEED_API_KEY=
